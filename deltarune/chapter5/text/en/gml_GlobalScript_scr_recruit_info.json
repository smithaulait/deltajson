  "scr_recruit_info_slash_scr_recruit_info_gml_661_0": "Kawkaw",
  "scr_recruit_info_slash_scr_recruit_info_gml_662_0": "A conical crow which lives in the ground. Disturbs Shi's crops, only because it wants to play with him.",
  "scr_recruit_info_slash_scr_recruit_info_gml_663_0": "Nyon!",
  "scr_recruit_info_slash_scr_recruit_info_gml_664_0": "Nyon...",

  "scr_recruit_info_slash_scr_recruit_info_gml_678_0": "Sheary",
  "scr_recruit_info_slash_scr_recruit_info_gml_679_0": "A familiar dancer with sharp legs. Only fights when provoked. Idolizes Blue.",
  "scr_recruit_info_slash_scr_recruit_info_gml_680_0": "Making doilies",

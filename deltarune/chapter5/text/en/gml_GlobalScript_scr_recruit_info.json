  "scr_recruit_info_slash_scr_recruit_info_gml_593_0": "Floradinn",
  "scr_recruit_info_slash_scr_recruit_info_gml_594_0": "Looks like Rudinn, but stronger and better. It thinks it's a flower and probably so does everyone else. Idolizes Flowery and Green.",
  "scr_recruit_info_slash_scr_recruit_info_gml_595_0": "Flowers",
  "scr_recruit_info_slash_scr_recruit_info_gml_596_0": "Other... things?",

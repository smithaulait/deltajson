  "scr_recruit_info_slash_scr_recruit_info_gml_644_0": "Shinobeetle",
  "scr_recruit_info_slash_scr_recruit_info_gml_645_0": "Seth's disciple. Instructed by Seth to be a master of Ninjutsu, but... watching Seth, just became a nerd.",
  "scr_recruit_info_slash_scr_recruit_info_gml_646_0": "Train photos",

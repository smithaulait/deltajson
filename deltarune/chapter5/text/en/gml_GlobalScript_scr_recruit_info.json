  "scr_recruit_info_slash_scr_recruit_info_gml_610_0": "Leafling",
  "scr_recruit_info_slash_scr_recruit_info_gml_611_0": "It blows carefree on the wind... until the wind stops blowing. Idolizes Aqua.",
  "scr_recruit_info_slash_scr_recruit_info_gml_612_0": "Windboarding",

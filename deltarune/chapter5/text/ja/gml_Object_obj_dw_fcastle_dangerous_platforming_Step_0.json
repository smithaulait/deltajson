{
  "obj_dw_fcastle_dangerous_platforming_slash_Step_0_gml_112_0": "\\E9＊ な？^1　やっぱ　このカベ\n　 越えられただろ？",
  "obj_dw_fcastle_dangerous_platforming_slash_Step_0_gml_114_0": "\\E2＊ (…スージィの　うれしそうな顔が\n　 見られたから^1…いっか)",
  "obj_dw_fcastle_dangerous_platforming_slash_Step_0_gml_310_0": "ボヨン…ボヨン…\n楽しすぎて\nこんなのは罰じゃねェ",
  "obj_dw_fcastle_dangerous_platforming_slash_Step_0_gml_321_0": "…ああ…楽しい…\nこれが“罰ゲーム”って\nヤツなのか…？",
  "obj_dw_fcastle_dangerous_platforming_slash_Step_0_gml_339_0": "線路に寝転がる…か…\n快適すぎて\nこんなのは罰じゃねェ",
  "obj_dw_fcastle_dangerous_platforming_slash_Step_0_gml_350_0": "そもそも　ここに\nずーっと寝てたって\n何も起きやしねェ…",
  "obj_dw_fcastle_dangerous_platforming_slash_Step_0_gml_396_0": "~1そこの　ふたり^1！\n　 オレは　ちょいと　DIYしなきゃ\n　 ならなくなった。/",
  "obj_dw_fcastle_dangerous_platforming_slash_Step_0_gml_397_0": "~1自爆する方法を　見つけねェと\n　 いけねェ。/%",
  "obj_dw_fcastle_dangerous_platforming_slash_Step_0_gml_407_0": "~1それが^1…オレにふさわしい罰なんだ…/%",
  "obj_dw_fcastle_dangerous_platforming_slash_Step_0_gml_416_0": "\\E6＊ クリス！^1　追っかけるぞ！/%",
  "obj_dw_fcastle_dangerous_platforming_slash_Step_0_gml_484_0": "~1おかしいわ^1…　イエローが　どこにも\n　 見当たらないの…/",
  "obj_dw_fcastle_dangerous_platforming_slash_Step_0_gml_485_0": "~1見つかったのは^1…大きな銃の残骸と…/",
  "obj_dw_fcastle_dangerous_platforming_slash_Step_0_gml_486_0": "~1…争ったような跡だけ…/",
  "obj_dw_fcastle_dangerous_platforming_slash_Step_0_gml_488_0": "\\EG＊ へ…へー^1…　だれかがイエローを^1…\n　 助けようとしてた^1…とかかな？/",
  "obj_dw_fcastle_dangerous_platforming_slash_Step_0_gml_495_0": "\\E2＊ …/",
  "obj_dw_fcastle_dangerous_platforming_slash_Step_0_gml_500_0": "\\EK＊ クリス^1　おまえ　どう思う？/",
  "obj_dw_fcastle_dangerous_platforming_slash_Step_0_gml_507_0": "\\E3＊ もう少し^1…調べてみるわ。/%",
  "obj_dw_fcastle_dangerous_platforming_slash_Step_0_gml_592_0": "トウモロコシの香りの\nロープが線路の上に…\nイエローのものだわ…",
  "obj_dw_fcastle_dangerous_platforming_slash_Step_0_gml_607_0": "帽子肥大…\nとてもマズいわ",
  "obj_dw_fcastle_dangerous_platforming_slash_Step_0_gml_711_0": "ターコが　アズゴアの\nゴルフボールを　全部\nここに落としてしまった…",
  "obj_dw_fcastle_dangerous_platforming_slash_Step_0_gml_718_0": "あー！\n動けない！",
  "obj_dw_fcastle_dangerous_platforming_slash_Step_0_gml_725_0": "やっと　オレに合う\nサイズが見つかった"
}
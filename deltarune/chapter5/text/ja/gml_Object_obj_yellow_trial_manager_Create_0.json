{
  "obj_yellow_trial_manager_slash_Create_0_gml_14_0": "証拠品：#",
  "obj_yellow_trial_manager_slash_Create_0_gml_15_0": "なし",
  "obj_yellow_trial_manager_slash_Create_0_gml_126_0": "イーッヒッヒ！\nターコが　やったよ！\nターコが　やったよ！",
  "obj_yellow_trial_manager_slash_Create_0_gml_127_0": "ジブンは^2…ただ^2…\n本を読んでいただけだ！",
  "obj_yellow_trial_manager_slash_Create_0_gml_129_0": "押し花にしようと\nしたのかも？",
  "obj_yellow_trial_manager_slash_Create_0_gml_130_0": "オレのブーツの底にャ\n何もないぜ",
  "obj_yellow_trial_manager_slash_Create_0_gml_133_0": "イヒヒヒヒ！\n燃えちゃえ！\n燃えちゃえ！",
  "obj_yellow_trial_manager_slash_Create_0_gml_134_0": "ランプのあかりで\n本を読んでたんだ！",
  "obj_yellow_trial_manager_slash_Create_0_gml_136_0": "本当に\nわざとかしら？",
  "obj_yellow_trial_manager_slash_Create_0_gml_137_0": "ウソつきは\nだれだ！？",
  "obj_yellow_trial_manager_slash_Create_0_gml_140_0": "ターコが　やったの！\nハンカチを\n血で　ブッ殺したの！",
  "obj_yellow_trial_manager_slash_Create_0_gml_141_0": "ターコ以外\nいないのか？",
  "obj_yellow_trial_manager_slash_Create_0_gml_143_0": "べつの理由が\nあったのかしら？",
  "obj_yellow_trial_manager_slash_Create_0_gml_144_0": "とてもキケンだ",
  "obj_yellow_trial_manager_slash_Create_0_gml_147_0": "ヒーヒッヒ！\nターコは　見つけられなかったの\n残念なの",
  "obj_yellow_trial_manager_slash_Create_0_gml_148_0": "やれやれ\nだれの仕業だか",
  "obj_yellow_trial_manager_slash_Create_0_gml_150_0": "…",
  "obj_yellow_trial_manager_slash_Create_0_gml_151_0": "オマエたち３人の\n仕業だな！\n絶対そうだ！！",
  "obj_yellow_trial_manager_slash_Create_0_gml_160_0": "んぐぐぐぐ^1…\nしょ…証拠は\nあるのか！？/%",
  "obj_yellow_trial_manager_slash_Create_0_gml_161_0": "モリス^2…その本の中を\n見せていただける？/%",
  "obj_yellow_trial_manager_slash_Create_0_gml_162_0": "…ひょっとしたら^1…\n花びらが　はさまって\nいるのではなくて？/%",
  "obj_yellow_trial_manager_slash_Create_0_gml_163_0": "…あ^1…あ…/%",
  "obj_yellow_trial_manager_slash_Create_0_gml_164_0": "そ…そのとおりだ！！/%",
  "obj_yellow_trial_manager_slash_Create_0_gml_165_0": "押し花を作って\nみたかったんだ！\n科学の実験だ！！/%",
  "obj_yellow_trial_manager_slash_Create_0_gml_166_0": "さすが　ブルーだぜ！！/%",
  "obj_yellow_trial_manager_slash_Create_0_gml_167_0": "よぅし　そっちの３人^1！\n１つは　オマエたちの\n仕業じゃないと証明された^1…\nが　他のは　どうだ！？/%",
  "obj_yellow_trial_manager_slash_Create_0_gml_170_0": "は！？^1　\nグリーン…\nポップコーンを\n作るつもり\nだったのか…？/%",
  "obj_yellow_trial_manager_slash_Create_0_gml_171_0": "トウモロコシ柄の\nシャツを\nホンモノの\nトウモロコシと\n間違えた！？/%",
  "obj_yellow_trial_manager_slash_Create_0_gml_172_0": "およ～^1　\nじょうずに\nできた？　できた？/%",
  "obj_yellow_trial_manager_slash_Create_0_gml_173_0": "オウ^1！\nじょうずに\nできたか？/%",
  "obj_yellow_trial_manager_slash_Create_0_gml_174_0": "イエロー！^1　バカッ^1！\nおまえのシャツが\nカリカリの黒焦げに\nなったんだろ！？/%",
  "obj_yellow_trial_manager_slash_Create_0_gml_175_0": "グリーン^1…\nわざとじゃないのは\nわかってるぜ/%",
  "obj_yellow_trial_manager_slash_Create_0_gml_176_0": "でも　正義は正義だ…/%",
  "obj_yellow_trial_manager_slash_Create_0_gml_179_0": "そだよ！　ターコよ！\nハンカチ　コロしたの！/%",
  "obj_yellow_trial_manager_slash_Create_0_gml_180_0": "それは　違うわ\nだって…/%",
  "obj_yellow_trial_manager_slash_Create_0_gml_181_0": "あなた\nいま　そのハンカチを\n身につけているじゃない！/%",
  "obj_yellow_trial_manager_slash_Create_0_gml_182_0": "そだよ！　ターコ　赤いリボン\n作りたかったの！^1　\n１色だけじゃ　つまんないから！/%",
  "obj_yellow_trial_manager_slash_Create_0_gml_183_0": "それとね　それとね\nボーリョクテキな\nハンザイゲンバも\n作りたかったの！\n(食紅で)/%",
  "obj_yellow_trial_manager_slash_Create_0_gml_184_0": "さすが　ターコだ\n罰を与えてやるぜ/%",
  "obj_yellow_trial_manager_slash_Create_0_gml_185_0": "やったぁ！！/%",
  "obj_yellow_trial_manager_slash_Create_0_gml_188_0": "…ブルー！？/%",
  "obj_yellow_trial_manager_slash_Create_0_gml_189_0": "あんな大事なものを\nブルーが盗んだって\nいうのか！？/%",
  "obj_yellow_trial_manager_slash_Create_0_gml_190_0": "そんなことを言う\n不届き者は^1…\nこのオレが…！/%",
  "obj_yellow_trial_manager_slash_Create_0_gml_191_0": "…イエロー/%",
  "obj_yellow_trial_manager_slash_Create_0_gml_192_0": "どうした　ブルー？/%",
  "obj_yellow_trial_manager_slash_Create_0_gml_193_0": "…/%",
  "obj_yellow_trial_manager_slash_Create_0_gml_194_0": "わたしが\nやったのよ/%",
  "obj_yellow_trial_manager_slash_Create_0_gml_195_0": "えぇッ！？/%",
  "obj_yellow_trial_manager_slash_Create_0_gml_199_0": "ターコじゃない^2…\nけど^1　逮捕して\nくれないか？/%",
  "obj_yellow_trial_manager_slash_Create_0_gml_200_0": "だれか　教えて？　教えて^1？\nハンザイって　どうやるの？\nヒヒヒのヒ/%",
  "obj_yellow_trial_manager_slash_Create_0_gml_201_0": "この犯罪は\n違う/%",
  "obj_yellow_trial_manager_slash_Create_0_gml_202_0": "そうね/%",
  "obj_yellow_trial_manager_slash_Create_0_gml_204_0": "およ！　およ！\nターコ　有罪！\nターコ　有罪！/%",
  "obj_yellow_trial_manager_slash_Create_0_gml_205_0": "すまない　ターコ…/%",
  "obj_yellow_trial_manager_slash_Create_0_gml_206_0": "待って^1。その証拠品じゃ\nなんの証明にも\nならないわ/%",
  "obj_yellow_trial_manager_slash_Create_0_gml_207_0": "もう一度よく\n考えてみて/%",
  "obj_yellow_trial_manager_slash_Create_0_gml_208_0": "(とりあえず\nターコを捕まえれば\nよいのでは？)/%",
  "obj_yellow_trial_manager_slash_Create_0_gml_210_0": "およ！　およ！\n証拠品　違ってる！/%",
  "obj_yellow_trial_manager_slash_Create_0_gml_212_0": "およ！\nターコ　ハサミ盗んだ！\n有罪！　有罪！/%",
  "obj_yellow_trial_manager_slash_Create_0_gml_213_0": "そういう話じゃ\nないだろ！/%",
  "obj_yellow_trial_manager_slash_Create_0_gml_214_0": "むにゅぅ～^1…\nモリスは…\nターコが無罪って\n言ってるの…？/%",
  "obj_yellow_trial_manager_slash_Create_0_gml_215_0": "頼むから\n正しい証拠品を\n選んでくれ！/%",
  "obj_yellow_trial_manager_slash_Create_0_gml_216_0": "この戦犯を\nろう屋にブチ込め！！/%",
  "obj_yellow_trial_manager_slash_Create_0_gml_218_0": "およ！　ターコ　ハサミ盗んだ！\n無罪だよ！　無罪なの！/%",
  "obj_yellow_trial_manager_slash_Create_0_gml_219_0": "なあ^1…ターコのリボン^1…\n前から　あんなだったか…？/%",
  "obj_yellow_trial_manager_slash_Create_0_gml_222_0": "なぜ　そうなる！？\nブルーとイエローが\nオマエたちの敵だろう！！/%",
  "obj_yellow_trial_manager_slash_Create_0_gml_223_0": "モリスのせい！\nモリスのせい！\nイーッヒッヒ！/%",
  "obj_yellow_trial_manager_slash_Create_0_gml_224_0": "モリスじゃねェかも\nだぜ…/%",
  "obj_yellow_trial_manager_slash_Create_0_gml_225_0": "そうね/%",
  "obj_yellow_trial_manager_slash_Create_0_gml_227_0": "ハハッ！\nその証拠品は違うぞ！/%",
  "obj_yellow_trial_manager_slash_Create_0_gml_228_0": "あー…じゃなくてー^1…\nなんでもない！/%",
  "obj_yellow_trial_manager_slash_Create_0_gml_230_0": "列車！？\n列車を使ったと\n思っているのか！？/%",
  "obj_yellow_trial_manager_slash_Create_0_gml_231_0": "列車か^1…\n使ったら　いったい　どんな\n科学的知識が得られ…/%",
  "obj_yellow_trial_manager_slash_Create_0_gml_232_0": "…じゃなくて^1…あー^1…\n黙秘する！/%",
  "obj_yellow_trial_manager_slash_Create_0_gml_235_0": "は！^2？\nグリーンのわけ\nないだろう！！/%",
  "obj_yellow_trial_manager_slash_Create_0_gml_236_0": "モリスだよ^2！\nそれか　ターコだよ！/%",
  "obj_yellow_trial_manager_slash_Create_0_gml_237_0": "すまねェな　グリーン…/%",
  "obj_yellow_trial_manager_slash_Create_0_gml_238_0": "ごめんなさい^1　\nグリーン…/%",
  "obj_yellow_trial_manager_slash_Create_0_gml_240_0": "グリーン！\nオマエだな！/%",
  "obj_yellow_trial_manager_slash_Create_0_gml_241_0": "違うよ　違うよ！\n証拠が　違うよ！/%",
  "obj_yellow_trial_manager_slash_Create_0_gml_244_0": "うっかり\nやった…？/%",
  "obj_yellow_trial_manager_slash_Create_0_gml_245_0": "イエローのせい！\nモリスのせい！/%",
  "obj_yellow_trial_manager_slash_Create_0_gml_246_0": "えぇッ！^1？\nボ…ボク\nハンザイーシャかも…/%",
  "obj_yellow_trial_manager_slash_Create_0_gml_247_0": "落ち着いて　イエロー^1　\nあなたは　やってないわ…/%",
  "obj_yellow_trial_manager_slash_Create_0_gml_249_0": "えぇッ！？^1　\n自分のシャツに\nオイルを…！？/%",
  "obj_yellow_trial_manager_slash_Create_0_gml_250_0": "だからこんなに\nパリパリなのか…/%",
  "obj_yellow_trial_manager_slash_Create_0_gml_251_0": "おやつがわりに\nフライパンで\n揚げちゃったんだな…/%",
  "obj_yellow_trial_manager_slash_Create_0_gml_252_0": "やっぱり　ボクは\nアツアツおやつ好きの\nハンザイーシャだったんだ…/%",
  "obj_yellow_trial_manager_slash_Create_0_gml_253_0": "イエロー^1　あなたは\n何も悪いことは\nしていないわ/%",
  "obj_yellow_trial_manager_slash_Create_0_gml_254_0": "えぇっ！^1？\nああ^1！　そうだった^1！\nオレは　そんなこと　やっちゃいねェ！/%",
  "obj_yellow_trial_manager_slash_Create_0_gml_255_0": "もう一度だ！/%",
  "obj_yellow_trial_manager_slash_Create_0_gml_258_0": "ターコのことか？/%",
  "obj_yellow_trial_manager_slash_Create_0_gml_259_0": "ターコのこと？/%",
  "obj_yellow_trial_manager_slash_Create_0_gml_260_0": "ブルーが\nハンザイーシャなんて\nありえねェぜ！！/%",
  "obj_yellow_trial_manager_slash_Create_0_gml_261_0": "いいのよ　イエロー^1　\nこのひとたちも\n悪気は　ないんだから/%",
  "obj_yellow_trial_manager_slash_Create_0_gml_263_0": "…/%",
  "obj_yellow_trial_manager_slash_Create_0_gml_266_0": "＊ ウザいイヌを　使った！/%",
  "obj_yellow_trial_manager_slash_Create_0_gml_267_0": "＊ ウザいイヌは　パチモンミサイルみたいに\n　 スッ飛んでいった！/%",
  "obj_yellow_trial_manager_slash_Create_0_gml_268_0": "証拠品…\n飛んでっちまったな…/%",
  "obj_yellow_trial_manager_slash_Create_0_gml_269_0": "ほら^1　これで　どう？/%",
  "obj_yellow_trial_manager_slash_Create_0_gml_273_0": "＊ (証拠は　合っていたようだ…)/%",
  "obj_yellow_trial_manager_slash_Create_0_gml_274_0": "＊ (加害者は　合っていたようだ…)/%",
  "obj_yellow_trial_manager_slash_Create_0_gml_275_0": "＊ (まったくの見当違いだったようだ…)/%",
  "obj_yellow_trial_manager_slash_Create_0_gml_279_0": "証拠品が\n足りないみたいね…/%",
  "obj_yellow_trial_manager_slash_Create_0_gml_280_0": "ほら^1　これで　どう？/%",
  "obj_yellow_trial_manager_slash_Create_0_gml_1074_0": "\\ER＊ スージィとクリスは　ろう屋の中で\n　 このコケを食べてた…/",
  "obj_yellow_trial_manager_slash_Create_0_gml_1075_0": "\\EE＊ 罪を犯していないひとが\n　 投獄されるなんて^1　あっては\n　 ならないことだ！/%",
  "obj_yellow_trial_manager_slash_Create_0_gml_1102_0": "盗みを働いたなら^1　\n罪を犯していないとは\nいえないよ？/%",
  "obj_yellow_trial_manager_slash_Create_0_gml_1173_0": "ペタルフェザー^1…\nキミたちは　これを\n社から盗んだだろう！？/%",
  "obj_yellow_trial_manager_slash_Create_0_gml_1180_0": "\\EC＊ そ^1…それは　ターコさんが^1…\n　 ボクたちに　くれたものだ！/%",
  "obj_yellow_trial_manager_slash_Create_0_gml_1183_0": "彼女のものじゃないのに\n勝手にあげるのはNGだよ/%",
  "obj_yellow_trial_manager_slash_Create_0_gml_1224_0": "残念だけれど^1　どうやら\nまた　ろう屋に…/%",
  "obj_yellow_trial_manager_slash_Create_0_gml_1243_0": "\\Et＊ ボ…ボクが　やったんだ^1！\n　 何もかも^1　ボクが思いついたこと\n　 だった！/%",
  "obj_yellow_trial_manager_slash_Create_0_gml_1253_0": "フフッ…/%",
  "obj_yellow_trial_manager_slash_Create_0_gml_1260_0": "\\Ee＊ クリス^1　スージィ^1　ごめん^1！\n　 あとは　まかせたよ！/%",
  "obj_yellow_trial_manager_slash_Create_0_gml_1310_0": "ラルぴぃ^1…\nなかなか\nやるね…/%",
  "obj_yellow_trial_manager_slash_Create_0_gml_1318_0": "でも^1　そんなことを\nしたって^1　仲間が\n闇の泉に近づける\nわけじゃない/%",
  "obj_yellow_trial_manager_slash_Create_0_gml_1628_0": "こんなもの\nボクは見たことが\nないよ…/%",
  "obj_yellow_trial_manager_slash_Create_0_gml_1649_0": "\\ER＊ な…なら…！/%"
}